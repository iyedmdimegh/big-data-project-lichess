# Image versions
CP_VERSION=7.6.0
SPARK_IMAGE_TAG=3.5-custom
CASSANDRA_VERSION=4.1
POSTGRES_VERSION=16
ELASTIC_VERSION=8.13.0
KIBANA_VERSION=8.13.0
GRAFANA_VERSION=10.4.0
METABASE_VERSION=v0.49.0

# Service ports
ZOOKEEPER_CLIENT_PORT=2181
ZOOKEEPER_TICK_TIME=2000
KAFKA_INTERNAL_PORT=9092
KAFKA_EXTERNAL_PORT=29092
KAFKA_UI_PORT=8080
KAFKA_UI_CONTAINER_PORT=8080
SPARK_MASTER_PORT=7077
SPARK_MASTER_WEBUI_PORT=8090
SPARK_WORKER_WEBUI_PORT_1=8091
SPARK_WORKER_WEBUI_PORT_2=8092
CASSANDRA_PORT=9042
POSTGRES_PORT=5434
POSTGRES_INTERNAL_PORT=5432
ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601
GRAFANA_PORT=3000
METABASE_PORT=3003
MB_DB_PORT=5432

# Kafka
KAFKA_BROKER_ID=1
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1

# Kafka topics
TOPIC_GAME_MOVES=game_moves
TOPIC_GAME_EVENTS=game_events
TOPIC_ENRICHED_GAMES=enriched_games

# PostgreSQL - main app
POSTGRES_USER=chess
POSTGRES_PASSWORD=chess123
POSTGRES_DB=chessdb

# PostgreSQL - metabase metadata
MB_DB_HOST=metabase-db
MB_DB_DBNAME=metabasedb
MB_DB_USER=metabase
MB_DB_PASS=metabase123

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin123

# Elasticsearch
ES_JAVA_OPTS=-Xms512m -Xmx512m

# Metabase admin (used by metabase/setup.sh to initialise the instance)
METABASE_ADMIN_EMAIL=admin@chess.local
METABASE_ADMIN_PASSWORD=Chess123!
METABASE_ADMIN_FIRSTNAME=Chess
METABASE_ADMIN_LASTNAME=Admin
METABASE_SITE_NAME=Chess Pipeline

# Experimental: Trino + Metabase #2 (reads Cassandra via Trino)
TRINO_PORT=8081
METABASE_TRINO_PORT=3004
MB_TRINO_DB_USER=metabase_trino
MB_TRINO_DB_PASS=metabase_trino_pw
MB_TRINO_DB_DBNAME=metabasedb_trino
METABASE_TRINO_ADMIN_EMAIL=admin@chess-cassandra.local
METABASE_TRINO_ADMIN_PASSWORD=Chess123!
METABASE_TRINO_SITE_NAME=Chess Pipeline (Cassandra)
